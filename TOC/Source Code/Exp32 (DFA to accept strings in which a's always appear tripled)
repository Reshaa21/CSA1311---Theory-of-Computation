#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i = 0;

    printf("Enter the string: ");
    scanf("%s", str);

    while(str[i] != '\0')
    {
        if(str[i] == 'a')
        {
            if(str[i+1] == 'a' && str[i+2] == 'a')
                i += 3;
            else
            {
                printf("String Rejected\n");
                return 0;
            }
        }
        else if(str[i] == 'b')
        {
            i++;
        }
        else
        {
            printf("Invalid Input\n");
            return 0;
        }
    }

    printf("String Accepted\n");

    return 0;
}