#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i;

    printf("Enter the binary string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] != '0' && str[i] != '1')
        {
            printf("Invalid Input\n");
            return 0;
        }
    }

    if(str[strlen(str)-1] == '1')
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}