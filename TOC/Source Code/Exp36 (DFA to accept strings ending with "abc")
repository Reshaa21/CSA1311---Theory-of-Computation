#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int len, i;
    printf("Enter the string: ");
    scanf("%s", str);
    len = strlen(str);
    for(i = 0; i < len; i++)
    {
        if(str[i] != 'a' && str[i] != 'b' && str[i] != 'c')
        {
            printf("Invalid Input\n");
            return 0;
        }
    }
    if(len >= 3 &&
       str[len-3] == 'a' &&
       str[len-2] == 'b' &&
       str[len-1] == 'c')
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}