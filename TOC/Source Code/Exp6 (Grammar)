#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int left = 0, right = 0;
    int i = 0, len;
    printf("Enter the string: ");
    scanf("%s", str);

    len = strlen(str);

    while(str[i] == '0')
    {
        left++;
        i++;
    }
    while(str[i] == '1')
        i++;

    while(i < len)
    {
        if(str[i] == '0')
            right++;
        else
        {
            printf("String Rejected\n");
            return 0;
        }
        i++;
    }
    if(left == right)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");
    return 0;
}