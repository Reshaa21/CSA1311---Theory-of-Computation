#include <stdio.h>
#include <string.h>
int main()
{
    char binary[100];
    int i, decimal = 0;
    printf("Enter a binary number: ");
    scanf("%s", binary);
    for(i = 0; binary[i] != '\0'; i++)
    {
        if(binary[i] != '0' && binary[i] != '1')
        {
            printf("Invalid Binary Number\n");
            return 0;
        }
        decimal = decimal * 2 + (binary[i] - '0');
    }
    if(decimal % 3 == 0)
        printf("Binary number is a multiple of 3\n");
    else
        printf("Binary number is not a multiple of 3\n");
    return 0;
}