#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i, count = 0;
    printf("Enter the string: ");
    scanf("%s", str);
    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == 'a')
            count++;
        else if(str[i] != 'b')
        {
            printf("Invalid Input\n");
            return 0;
        }
    }
    if(count % 2 == 0)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");
    return 0;
}