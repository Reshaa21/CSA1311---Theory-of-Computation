#include <stdio.h>
#include <string.h>
int main() {
    char s[100];
    int i, flag = 0;
    scanf("%99s", s);
    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] == '1' && s[i+1] == '0' && s[i+2] == '1') {
            flag = 1;
            break;
        }
    }
    if (flag)
        printf("Accepted");
    else
        printf("Rejected");
    return 0;
}
