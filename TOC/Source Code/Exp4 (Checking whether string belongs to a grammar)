#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i, valid = 1;
    int len;

    printf("Enter the string: ");
    scanf("%s", str);

    len = strlen(str);

    for(i = 0; i < len; i++)
    {
        if(str[i] != '0' && str[i] != '1')
        {
            valid = 0;
            break;
        }
    }

    if(!valid)
    {
        printf("Invalid String\n");
        return 0;
    }

    if(str[0] == '0' && str[len - 1] == '1')
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}