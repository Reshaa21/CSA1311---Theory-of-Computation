#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i = 0, a = 0, b = 0;
    printf("Enter the string: ");
    scanf("%s", str);
    while(str[i] == 'a')
    {
        a++;
        i++;
    }
    while(str[i] == 'b')
    {
        b++;
        i++;
    }
    if(str[i] != '\0')
    {
        printf("String Rejected\n");
        return 0;
    }
    if(b == 2 * a)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}