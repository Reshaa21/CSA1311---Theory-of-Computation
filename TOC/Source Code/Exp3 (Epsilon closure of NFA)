#include <stdio.h>
int main()
{
    int states, i, j;
    int eclosure[10][10];

    printf("Enter the number of states: ");
    scanf("%d", &states);

    printf("Enter the epsilon closure matrix:\n");

    for(i = 0; i < states; i++)
    {
        for(j = 0; j < states; j++)
        {
            scanf("%d", &eclosure[i][j]);
        }
    }
    printf("\nEpsilon Closures are:\n");

    for(i = 0; i < states; i++)
    {
        printf("E-Closure(q%d) = { ", i);

        for(j = 0; j < states; j++)
        {
            if(eclosure[i][j] == 1)
                printf("q%d ", j);
        }

        printf("}\n");
    }
    return 0;
}