#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int len, i, pos = -1;

    printf("Enter the string: ");
    scanf("%s", str);

    len = strlen(str);

    for(i = 0; i < len; i++)
    {
        if(str[i] == 'c')
        {
            pos = i;
            break;
        }
    }
    if(pos == -1)
    {
        printf("String Rejected\n");
        return 0;
    }
    if(pos != len - pos - 1)
    {
        printf("String Rejected\n");
        return 0;
    }

    for(i = 0; i < pos; i++)
    {
        if(str[i] != str[pos + 1 + i])
        {
            printf("String Rejected\n");
            return 0;
        }
    }
    printf("String Accepted\n");
    return 0;
}