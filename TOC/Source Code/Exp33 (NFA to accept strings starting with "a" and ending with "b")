#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i, len;

    printf("Enter the string: ");
    scanf("%s", str);

    len = strlen(str);

    for(i = 0; i < len; i++)
    {
        if(str[i] != 'a' && str[i] != 'b')
        {
            printf("Invalid Input\n");
            return 0;
        }
    }

    if(str[0] == 'a' && str[len - 1] == 'b')
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}