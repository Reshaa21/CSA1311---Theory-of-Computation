#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int len, i;
    printf("Enter the string: ");
    scanf("%s", str);
    len = strlen(str);
    if(len % 2 != 0)
    {
        printf("String Rejected\n");
        return 0;
    }
    for(i = 0; i < len / 2; i++)
    {
        if(str[i] != str[i + len / 2])
        {
            printf("String Rejected\n");
            return 0;
        }
    }
    printf("String Accepted\n");
    return 0;
}