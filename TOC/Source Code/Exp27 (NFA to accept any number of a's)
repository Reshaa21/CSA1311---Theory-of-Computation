#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i;
    printf("Enter the string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] != 'a' && str[i] != 'b')
        {
            printf("Invalid Input\n");
            return 0;
        }
    }
    printf("String Accepted\n");
    return 0;
}