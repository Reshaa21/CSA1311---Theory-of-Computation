#include <stdio.h>
#include <string.h>
int main() {
    char s[100];
    int i = 0, j, flag = 1;
    scanf("%99s", s);
    j = strlen(s) - 1;
    while (i < j && s[i] == '0' && s[j] == '0') {
        i++;
        j--;
    }
    for (; i <= j; i++) {
        if (s[i] != '1') {
            flag = 0;
            break;
        }
    }
    if (flag)
        printf("Accepted");
    else
        printf("Rejected");
    return 0;
}
