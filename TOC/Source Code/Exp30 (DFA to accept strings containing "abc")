#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i, found = 0;

    printf("Enter the string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] != 'a' && str[i] != 'b' && str[i] != 'c')
        {
            printf("Invalid Input\n");
            return 0;
        }
    }

    for(i = 0; i < strlen(str) - 2; i++)
    {
        if(str[i] == 'a' &&
           str[i+1] == 'b' &&
           str[i+2] == 'c')
        {
            found = 1;
            break;
        }
    }

    if(found)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}