#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i = 0, zeros = 0, ones = 0;
    int len;

    printf("Enter the string: ");
    scanf("%s", str);

    len = strlen(str);

    while(str[i] == '0')
    {
        zeros++;
        i++;
    }

    while(str[i] == '1')
    {
        ones++;
        i++;
    }

    if(i == len && zeros == ones)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}