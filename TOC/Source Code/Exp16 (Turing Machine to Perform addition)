#include <stdio.h>
#include <string.h>
int main()
{
    char num1[100], num2[100];
    printf("Enter first unary number: ");
    scanf("%s", num1);
    printf("Enter second unary number: ");
    scanf("%s", num2);
    strcat(num1, num2);
    printf("Result after addition: %s\n", num1);
    return 0;
}